{
  "expo": {
    "name": "Levanto Employer",
    "slug": "levanto-employer",
    "version": "1.0.0",
    "scheme": "levanto",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6240CB"
    },
    "ios": {
      "bundleIdentifier": "com.levanto.employer",
      "supportsTablet": true
    },
    "android": {
      "package": "com.levanto.employer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6240CB"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
